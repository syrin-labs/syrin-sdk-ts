# Syrin SDK — Environment variables
# ==================================
# 1. Start the backend:    cd syrin-backend && npm run dev
# 2. Open the dashboard:   http://localhost:5173
# 3. Create a project and generate an API key
# 4. Paste the API key below

SYRIN_API_KEY=your_syrin_api_key_here

# Your OpenAI API key (required for LLM calls)
OPENAI_API_KEY=your_openai_api_key_here

# Backend URL (defaults to http://localhost:4000)
SYRIN_BACKEND_URL=http://localhost:4000
