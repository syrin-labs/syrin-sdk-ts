# Syrin SDK — Environment variables
# ==================================
# 1. Start the mock backend:  cd syrin-sdk-ts && npm run mock-backend
# 2. Create a project and generate an API key
# 3. Paste the API key below

SYRIN_API_KEY=your_syrin_api_key_here

# Your OpenAI API key (required for LLM calls in the examples)
OPENAI_API_KEY=your_openai_api_key_here

# Backend URL — point to the local mock backend while developing
SYRIN_BACKEND_URL=http://localhost:4000
